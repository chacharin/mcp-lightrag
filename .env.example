# =============================================================================
# mcp-lightrag — MCP server สำหรับค้นหาและเพิ่มเอกสารในคลังความรู้ LightRAG — ตัวอย่างไฟล์ .env
# เครื่องมือ: lightrag_query (ค้นหาจากคลัง) และ lightrag_insert (เพิ่มเอกสารเข้าคลัง)
# -----------------------------------------------------------------------------
# ไฟล์นี้อธิบายการตั้งค่าทั้งหมดที่ปรับได้ โดยแบ่งเป็น 5 หมวดเช่นเดียวกับไฟล์ .env
# บรรทัดที่ไม่มี # นำหน้าคือค่าที่จำเป็นต้องกำหนดในไฟล์ .env
# บรรทัดที่มี # นำหน้าคือค่าเริ่มต้น หากไม่กำหนดในไฟล์ .env ระบบจะใช้ค่านี้
# เมื่อแก้ไขไฟล์ .env แล้ว ให้สั่ง docker compose up -d เพื่อสร้าง container ใหม่
# =============================================================================

# --- LightRAG ---
# ที่อยู่ของ LightRAG server บน docker network (ใช้ชื่อ container และพอร์ตภายใน container ไม่ใช่พอร์ตบนเครื่อง)
#   หาก LightRAG อยู่นอก docker network นี้ ให้ใช้ URL ที่เข้าถึงได้จาก container เช่น http://host.docker.internal:9621
LIGHTRAG_URL=http://lightrag:9621
# API key (ค่าลับ) ต้องตรงกับ LIGHTRAG_API_KEY ที่ตั้งไว้ใน LightRAG server
#   จำเป็นต้องกำหนด หากเว้นว่าง ระบบจะไม่เริ่มทำงาน เพราะ LightRAG ที่ไม่มี key จะให้ทุกคนที่เข้าถึงได้อ่าน เพิ่ม และลบเอกสารได้
#   หาก LightRAG server ยังไม่มี key ให้ตั้งที่ LightRAG ก่อน ควรใช้ key ที่สุ่มและยาวอย่างน้อย 32 ตัวอักษร เช่น สร้างด้วยคำสั่ง
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
LIGHTRAG_API_KEY=change-me
# เวลารอคำตอบจาก LightRAG สูงสุด (วินาที) การค้นหาแต่ละครั้งต้องรอ LLM ของ LightRAG สรุปคำตอบ
#   ควรตั้ง timeout ของเอเจนต์ให้นานกว่าค่านี้
# QUERY_TIMEOUT_SECONDS=120
# เวลารอ LightRAG รับเอกสาร (วินาที) LightRAG ตอบรับทันทีแล้วจึงสกัดเอนทิตีในเบื้องหลัง ค่านี้จึงไม่ต้องสูงมาก
# INSERT_TIMEOUT_SECONDS=60

# --- การค้นหา ---
# วิธีค้นหาที่ให้เอเจนต์เลือกได้ คั่นด้วย ,
#   mix    = ค้นทั้งกราฟความสัมพันธ์และข้อความที่ใกล้เคียง (ครอบคลุมที่สุด)
#   hybrid = รวม local และ global
#   local  = เน้นรายละเอียดของสิ่งที่ถามถึงโดยตรง
#   global = เน้นภาพรวมและความเชื่อมโยงในวงกว้าง
#   naive  = ค้นจากข้อความที่ใกล้เคียงเท่านั้น ไม่ใช้กราฟ
#   bypass = ส่งคำถามให้ LLM ตอบโดยไม่ค้นคลัง (ไม่ได้เปิดไว้ในค่าเริ่มต้น)
# QUERY_MODES=mix,hybrid,local,global,naive
# วิธีค้นหาที่ใช้เมื่อเอเจนต์ไม่ได้ระบุ หรือระบุวิธีที่ไม่มีในรายการ (ต้องเป็นหนึ่งใน QUERY_MODES)
# DEFAULT_MODE=hybrid
# ค่าเพิ่มเติมที่ส่งไปกับทุกการค้นหา ในรูปแบบ JSON object บรรทัดเดียว (ห้ามกำหนด query, mode หรือ stream)
#   เช่น {"top_k": 40, "response_type": "Bullet Points"} ดูชื่อค่าที่รองรับได้จากเอกสาร API ของ LightRAG (/docs)
#   หากรูปแบบ JSON ไม่ถูกต้อง ระบบจะไม่เริ่มทำงาน
# QUERY_EXTRA_PARAMS=

# --- การทำงานร่วมกับเอเจนต์ ---
# คำอธิบายสั้น ๆ ว่าคลังนี้เก็บเอกสารเรื่องอะไร ระบบจะแสดงข้อความนี้ในคำอธิบายเครื่องมือ
#   เพื่อให้เอเจนต์ตัดสินใจได้ว่าคำถามใดควรค้นจากคลังนี้ เช่น คู่มือและนโยบายภายในของบริษัท
# KB_DESCRIPTION=
# true = เอเจนต์เพิ่มเอกสารเข้าคลังได้ · false = ค้นหาได้อย่างเดียว (ไม่มีเครื่องมือ lightrag_insert)
# ENABLE_INSERT=true
# true = เอเจนต์ลบเอกสารออกจากคลังได้ (เครื่องมือ lightrag_delete) · false = ไม่มีเครื่องมือนี้
#   ⚠ เอกสารที่ลบแล้ว รวมทั้งเอนทิตีและความสัมพันธ์ที่สกัดจากเอกสารนั้น จะกู้คืนไม่ได้
# ENABLE_DELETE=false
# หากกำหนด เอเจนต์ต้องส่ง "Authorization: Bearer <ค่านี้>" ทุกครั้ง (ค่าลับ)
#   หากเว้นว่างจะไม่ตรวจสอบ ⚠ เมื่อเปิดพอร์ตให้เครื่องอื่นเข้าถึง ทุกคนในเครือข่ายจะค้นหาและเพิ่มเอกสารในคลังได้
# MCP_AUTH_TOKEN=

# --- ข้อมูลการใช้งาน ---
# บันทึกเวลาของการเรียกเครื่องมือทุกครั้ง (ไม่มีคำถามหรือเนื้อหา) อ่านได้ที่ GET /usage
# USAGE_LOG=true
# โฟลเดอร์ภายใน container ที่เก็บไฟล์ usage-<วันที่>.jsonl (docker-compose.yml mount volume "usage" ไว้ที่นี่)
# USAGE_DIR=/app/usage
# มิเตอร์: endpoint จริงของผู้ให้บริการ LLM ที่ LightRAG ใช้ เพื่อนับ token ของ LightRAG (เว้นว่าง = ปิด)
#   เมื่อเปิด ให้ตั้ง LLM_BINDING_HOST และ EMBEDDING_BINDING_HOST ของ LightRAG เป็น http://mcp-lightrag:8700/meter
# METER_UPSTREAM=
# เวลารอผู้ให้บริการต่อหนึ่งคำขอของมิเตอร์ (วินาที)
# METER_TIMEOUT_SECONDS=600

# --- docker compose ---
# docker network ที่ใช้ร่วมกับเอเจนต์และ LightRAG (ต้องสร้างก่อนด้วยคำสั่ง docker network create <ชื่อ>)
# DOCKER_NETWORK=agent_network
# 0.0.0.0 = เครื่องอื่นในเครือข่ายเข้าถึงได้ · 127.0.0.1 = เข้าถึงได้เฉพาะเครื่องนี้
# PUBLISH_ADDR=0.0.0.0
# พอร์ตบนเครื่อง
# PUBLISH_PORT=8806
