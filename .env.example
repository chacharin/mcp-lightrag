# Copy this file to .env and fill in real values. Never commit .env itself
# (it is already listed in .gitignore).
#
# These are read by mcp_lightrag.config.Settings (pydantic-settings). Every
# value here can also be passed as a CLI flag to `mcp-lightrag`; the flag
# wins if both are set. See plan.md section 3 for the full reference table.

# Base URL of the LightRAG server.
# Use http://localhost:9621 when running mcp-lightrag directly on the host,
# or http://lightrag:9621 when running inside the Hermes container on the
# same Docker network as the LightRAG container.
LIGHTRAG_URL=http://localhost:9621

# API key sent as the X-API-Key header. Leave empty if the LightRAG server
# has no API key configured.
LIGHTRAG_API_KEY=

# Only needed if the LightRAG server uses AUTH_ACCOUNTS (username/password)
# instead of, or in addition to, an API key. Leave both empty otherwise.
LIGHTRAG_USERNAME=
LIGHTRAG_PASSWORD=

# Timeouts, in seconds.
LIGHTRAG_TIMEOUT=30
LIGHTRAG_QUERY_TIMEOUT=180
LIGHTRAG_UPLOAD_TIMEOUT=300

# Verify the LightRAG server's TLS certificate. Set to false only for local
# testing against a server with a self-signed certificate.
LIGHTRAG_VERIFY_SSL=true

# Name this MCP server reports to clients. Change this when running several
# instances against different LightRAG classification tiers (see plan.md
# Phase 7) so Hermes can tell them apart.
MCP_SERVER_NAME=lightrag

# stdio is what Hermes uses when it launches this process via `uvx`.
# streamable-http is only needed for standalone testing (e.g. MCP Inspector
# against a long-running instance).
MCP_TRANSPORT=stdio

# Logging verbosity. Always written to stderr, never stdout, so it can never
# collide with the stdio JSON-RPC stream.
LOG_LEVEL=INFO
